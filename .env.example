# whalibmob — example environment configuration
#
# Copy this file to `.env` in your project root and uncomment what you need:
#
#     cp node_modules/whalibmob/.env.example .env
#
# The CLI loads `.env` from the current working directory automatically.
# If you use the library programmatically, call `require('dotenv').config()`
# yourself before creating a client.
#
# Every variable below is OPTIONAL — with an empty .env the library runs with
# the defaults shown next to each entry.


# ─── Device profile ──────────────────────────────────────────────────────────
# Which platform to identify as during registration and connection.
# Values: ios | android
# WA_OS=ios

# Named predefined device profile. Takes priority over the individual
# WA_DEVICE_* variables below.
#
#   ios      iphone15pro, iphone15, iphone14, iphone14pro, iphone13, iphone12
#   android  samsung-s24-ultra, samsung-s24, samsung-s23, samsung-s23-ultra,
#            samsung-a55, pixel8pro, pixel8, pixel7, pixel7a, xiaomi14,
#            xiaomi13, oneplus12, oneplus11, oppo-find-x7, realme-gt5
#
# Default: iphone15pro when WA_OS=ios, samsungs24ultra when WA_OS=android
# WA_DEVICE=iphone15pro


# ─── Custom device profile ───────────────────────────────────────────────────
# Only used when WA_DEVICE does not match a predefined profile. Any value left
# unset falls back to the default profile for the selected WA_OS.
# The defaults shown here are the iOS ones (iPhone 15 Pro).

# Device display name — e.g. "iPhone 15 Pro", "Samsung Galaxy S24 Ultra"
# WA_DEVICE_MODEL=iPhone 15 Pro

# Apple | Samsung | Google | Xiaomi | OnePlus …
# WA_DEVICE_MANUFACTURER=Apple

# OS version string — e.g. 17.4.1 for iOS, 14 for Android
# WA_DEVICE_OS_VERSION=17.4.1

# OS build number — e.g. 21E236 for iOS, UP1A.231005.007 for Android
# WA_DEVICE_BUILD=21E236

# Internal model identifier — e.g. iPhone16,1 for iOS, SM-S928B for Android
# WA_DEVICE_MODEL_ID=iPhone16,1


# ─── WhatsApp version ────────────────────────────────────────────────────────
# Pin the WhatsApp client version. When set, the live version lookup is skipped
# entirely, and this is what is announced on connect in place of the version
# stored in the session. Leave unset to fetch the current version automatically.
#
# Leaving it unset is the recommended setting. Connecting looks the current
# version up on its own and takes the newest of the store listing, the APK the
# Android token material came from, and the one the session registered with — so
# a session does not go stale into a 405. Setting this pins the version and skips
# all of that.
# WA_VERSION=2.24.10.75

# Override the static registration token. iOS only — Android has no static token
# and signs its own out of the APK (see below). Leave unset to use the built-in
# one; only change this if you know what you are doing.
# WA_STATIC_TOKEN=


# ─── Android registration token material ─────────────────────────────────────
# Registering with WA_OS=android needs material read out of a WhatsApp APK. The
# first registration fetches the APK from Google Play and does this on its own —
# nothing to run first. To do it by hand, from a Play download or an APK you
# already have:
#
#     wa apk-material --download
#     wa apk-material base.apk [split_config.xxhdpi.apk ...]
#
# It is written to <session dir>/android-apk-material.json by default. Set this
# to keep it somewhere else. Registering as iOS needs none of it.
# WA_ANDROID_APK_MATERIAL=/path/to/android-apk-material.json

# Never fetch the APK automatically. Registration then fails with instructions
# instead of pulling a hundred megabytes unasked.
# WA_NO_APK_DOWNLOAD=1

# Register with material from an APK that is not signed by WhatsApp. Refused by
# default, because a re-signed APK yields a token that belongs to nobody and
# spends code requests against your number for nothing.
# WA_ALLOW_FOREIGN_APK=1


# ─── Proxy ───────────────────────────────────────────────────────────────────
# Route registration traffic through a SOCKS proxy. Requires the `socks`
# package: npm install socks
#
# A bare host:port is assumed to be socks5. Add a scheme to be explicit, and
# credentials if the proxy needs them. Percent-encode any @ or : in a password.
#
#   TOR_PROXY takes precedence over SOCKS_PROXY when both are set.
#   The default Tor SOCKS port is 9050; the SOCKS default is 1080.
#
# TOR_PROXY=127.0.0.1:9050
# TOR_PROXY=socks5://127.0.0.1:9050
# SOCKS_PROXY=socks5://user:pass@proxy.example.com:1080
# SOCKS_PROXY=socks5h://proxy.example.com:1080
# SOCKS_PROXY=socks4://proxy.example.com:1080
#
# Only if `socks` lives somewhere require() cannot find it:
# WA_SOCKS_LIB=/absolute/path/to/socks/build/index.js


# ─── Registration funnel telemetry ───────────────────────────────────────────
# Registration reports the screens it passes through to WhatsApp's /client_log,
# the way the phone clients do. It is fire-and-forget — every failure is
# swallowed and it can never take a registration down.
#
# Set to 0 to send none of it.
# WA_FUNNEL_LOG=0


# ─── Frida attestation bridge ────────────────────────────────────────────────
# Host running the Frida attestation helper (see the frida/ directory).
# Leave unset to disable the bridge.
# WA_FRIDA_HOST=127.0.0.1

# Port the helper listens on.
# Default: 1119 (WhatsApp consumer; the Business build listens on 1120)
# WA_FRIDA_PORT=1119
