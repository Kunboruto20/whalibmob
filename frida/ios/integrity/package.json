{
  "name": "whalibmob-frida-ios",
  "version": "1.0.0",
  "description": "Frida middleware exposing iOS App Attest over a local HTTP server, consumed by whalibmob during registration",
  "private": true,
  "main": "server.js",
  "scripts": {
    "prepare": "npm run build",
    "build": "frida-compile server.js -o server_with_dependencies.js -c",
    "watch": "frida-compile server.js -o server_with_dependencies.js -w"
  },
  "devDependencies": {
    "@types/frida-gum": "^18.5.1",
    "@types/node": "^18.19.3",
    "frida-compile": "^16.4.1"
  }
}
